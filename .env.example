# Keep these on the server. Do not put them in app.js or index.html.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_USE_SEARCH=true
GROQ_API_KEY=
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
# Preferred Google Images adapter for the first matching product image.
SERPAPI_KEY=
# Optional image providers. Google Custom Search needs both values.
GOOGLE_SEARCH_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=
PEXELS_API_KEY=
PORT=4173
